# Public URL of this MCP server (used as the OAuth resource identifier)
NOMAI_MCP_RESOURCE_SERVER_URL=https://mcp.nomaitech.com

# Your company's existing OAuth/OIDC provider (Auth0, Okta, Google Workspace, Keycloak, ...)
NOMAI_MCP_OAUTH_ISSUER_URL=https://your-tenant.example.com/
NOMAI_MCP_OAUTH_JWKS_URI=https://your-tenant.example.com/.well-known/jwks.json
NOMAI_MCP_OAUTH_AUDIENCE=https://mcp.nomaitech.com

NOMAI_MCP_HOST=0.0.0.0
NOMAI_MCP_PORT=8000
