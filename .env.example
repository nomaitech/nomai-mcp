# This server's own public URL — it's both the OAuth issuer and resource
# identifier, and its Google callback route is at <this>/google/callback
NOMAI_MCP_SERVER_URL=https://mcp.nomaitech.com

# Google "Web application" OAuth credentials (Google Cloud Console >
# APIs & Services > Credentials). Held only here, server-side — end users
# never see these. Authorized redirect URI must be exactly:
#   <NOMAI_MCP_SERVER_URL>/google/callback
NOMAI_MCP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NOMAI_MCP_GOOGLE_CLIENT_SECRET=your-client-secret

# Only these emails are allowed to use the server
NOMAI_MCP_ALLOWED_EMAILS=["you@nomaitech.com","teammate@nomaitech.com"]

NOMAI_MCP_HOST=0.0.0.0
NOMAI_MCP_PORT=8000
