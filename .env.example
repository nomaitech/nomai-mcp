# Public URL of this MCP server (used as the OAuth resource identifier)
NOMAI_MCP_RESOURCE_SERVER_URL=https://mcp.nomaitech.com

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services > Credentials)
NOMAI_MCP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of emails allowed to use this server
NOMAI_MCP_ALLOWED_EMAILS=["you@nomaitech.com","teammate@nomaitech.com"]

NOMAI_MCP_HOST=0.0.0.0
NOMAI_MCP_PORT=8000
